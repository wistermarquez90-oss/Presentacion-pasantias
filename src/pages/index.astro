    <!-- ============ 23 · CONCLUSIONES ============ -->
    <section class="slide" data-steps="6" id="s23">
      <div class="content">
        <div class="slide-num"><b>23</b> / 24</div>
        <div class="kicker st" data-s="1">Conclusiones</div>
        <h1 class="s-title st" data-s="1" style="font-size:42px; margin-bottom:18px;">Cinco conclusiones</h1>
        <div style="display:flex; flex-direction:column; gap:16px;">
          <div class="st" data-s="2" style="display:flex; gap:20px; align-items:baseline;">
            <span class="tnum" style="font-size:30px; font-weight:800; color:var(--gold); flex:0 0 54px;">01</span>
            <span style="font-size:20px; line-height:1.45;">La crisis devastó el comercio bilateral (<b class="tnum">-93,6&nbsp;%</b> exp., <b class="tnum">-91,3&nbsp;%</b> imp.) y el PIB venezolano es su determinante dominante: elasticidades <b class="tnum">4,96</b> y <b class="tnum">2,13</b>.</span>
          </div>
          <div class="st" data-s="3" style="display:flex; gap:20px; align-items:baseline;">
            <span class="tnum" style="font-size:30px; font-weight:800; color:var(--gold); flex:0 0 54px;">02</span>
            <span style="font-size:20px; line-height:1.45;">El éxodo calca la secuencia de shocks (pico 2018) y es <b>estructural</b>: stock de 2,86 millones con intención de permanencia del <b class="tnum">88,2&nbsp;%</b>.</span>
          </div>
          <div class="st" data-s="4" style="display:flex; gap:20px; align-items:baseline;">
            <span class="tnum" style="font-size:30px; font-weight:800; color:var(--gold); flex:0 0 54px;">03</span>
            <span style="font-size:20px; line-height:1.45;">Fuga de capital humano con selección positiva, pero <b>retorno salarial nulo</b>: brain drain para Venezuela, brain waste en Colombia; brecha de género de <b class="tnum">30 pp</b> en empleo.</span>
          </div>
          <div class="st" data-s="5" style="display:flex; gap:20px; align-items:baseline;">
            <span class="tnum" style="font-size:30px; font-weight:800; color:var(--gold); flex:0 0 54px;">04</span>
            <span style="font-size:20px; line-height:1.45;">El marco legal fue <b>causa y consecuencia</b>: cierres 2015–2019 y contrabando vs. AAP N.° 28 (2023) y ETPV/PPT.</span>
          </div>
          <div class="st" data-s="6" style="display:flex; gap:20px; align-items:baseline;">
            <span class="tnum" style="font-size:30px; font-weight:800; color:var(--gold); flex:0 0 54px;">05</span>
            <span style="font-size:20px; line-height:1.45;">Comercio y migración son <b style="color:var(--gold);">dos caras de la misma crisis</b>: la reconstrucción bilateral debe abordar ambas conjuntamente.</span>
          </div>
        </div>
      </div>
    </section>

